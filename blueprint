#!/usr/bin/env bash
# Lightweight package-manager style CLI for shared-agent-blueprints.
# Usage: ./blueprint {init|install|update|sync|doctor} [blueprint] [--overlay NAME] [--runtime NAME] [--dry-run] [--force]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_ROOT="$ROOT"
VERSION_FILE="${PACKAGE_ROOT}/VERSION"
MANIFEST="${PACKAGE_ROOT}/manifest.yaml"
STATE_FILE=".agent-blueprint.yaml"
LOCAL_OVERRIDE=".agent-blueprint.local.yaml"
MARKER="<!-- managed-by: shared-agent-blueprints -->"

# shellcheck source=lib/blueprint/term.sh
source "${ROOT}/lib/blueprint/term.sh"
# shellcheck source=lib/blueprint/render.sh
source "${ROOT}/lib/blueprint/render.sh"
# shellcheck source=lib/blueprint/events.sh
source "${ROOT}/lib/blueprint/events.sh"
# shellcheck source=lib/blueprint/context.sh
source "${ROOT}/lib/blueprint/context.sh"
# shellcheck source=lib/blueprint/history.sh
source "${ROOT}/lib/blueprint/history.sh"
# shellcheck source=lib/blueprint/session.sh
source "${ROOT}/lib/blueprint/session.sh"
# shellcheck source=lib/blueprint/repo.sh
source "${ROOT}/lib/blueprint/repo.sh"

term_init

cmd="${1:-}"
# Flags-only invocation (e.g. ./blueprint --target ./repo) opens the menu.
if [[ -n "$cmd" && "$cmd" == -* && "$cmd" != -h && "$cmd" != --help ]]; then
  cmd="menu"
else
  shift || true
fi

BLUEPRINT="default"
OVERLAY=""
RUNTIME=""
RUNTIME_SET=0
DRY_RUN=0
FORCE=0
TARGET="."
BP_START_EPOCH=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --overlay) OVERLAY="${2:-}"; shift 2 ;;
    --runtime)
      RUNTIME="${2:-}"
      RUNTIME_SET=1
      shift 2
      ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force) FORCE=1; shift ;;
    --target) TARGET="${2:-.}"; shift 2 ;;
    -*)
      echo "unknown flag: $1" >&2
      exit 2
      ;;
    *)
      BLUEPRINT="$1"
      shift
      ;;
  esac
done

log() { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

# Backward-compatible ui_* wrappers used by doctor/menu.
ui_color() { term_color "$1"; }
ui_rule() {
  printf '%s────────────────────────────────────────────────────────%s\n' "$(term_color dim)" "$(term_color reset)"
}
ui_header() {
  local title="$1"
  printf '\n'
  ui_rule
  printf '  %s✦ %s%s\n' "$(term_color bold)$(term_color cyan)" "$title" "$(term_color reset)"
  ui_rule
}
ui_kv() {
  printf '  %s%-10s%s %s\n' "$(term_color dim)" "$1" "$(term_color reset)" "$2"
}
ui_section() {
  printf '\n  %s%s%s\n' "$(term_color bold)" "$1" "$(term_color reset)"
}
ui_ok() {
  printf '  %s✓%s  %s\n' "$(term_color green)" "$(term_color reset)" "$*"
}
ui_fail() {
  printf '  %s✗%s  %s\n' "$(term_color red)" "$(term_color reset)" "$*" >&2
}
ui_info() {
  printf '  %s!%s  %s\n' "$(term_color yellow)" "$(term_color reset)" "$*"
}
ui_skip() {
  printf '  %s⊘%s  %s\n' "$(term_color dim)" "$(term_color reset)" "$*"
}
ui_next() {
  printf '  %s→%s  %s\n' "$(term_color cyan)" "$(term_color reset)" "$*"
}
ui_footer_ok() {
  printf '\n'
  ui_rule
  printf '  %s✓  Healthy%s — ready to work\n' "$(term_color green)$(term_color bold)" "$(term_color reset)"
  ui_rule
  printf '\n'
}
ui_footer_fail() {
  local n="$1"
  printf '\n'
  ui_rule
  printf '  %s✗  %s issue(s)%s — fix, then re-run doctor\n' "$(term_color red)$(term_color bold)" "$n" "$(term_color reset)"
  ui_rule
  printf '\n'
}

refresh_package_paths() {
  VERSION_FILE="${PACKAGE_ROOT}/VERSION"
  MANIFEST="${PACKAGE_ROOT}/manifest.yaml"
}

bp_on_interrupt() {
  render_finalize_progress
  term_show_cursor
  session_mark_interrupted "${BP_CTX_ROOT:-$TARGET}" || true
  events_finish_op "interrupted"
  history_append || true
  printf '\n' >&2
  emit_warning "Interrupted — session preserved for resume"
  exit 130
}

bp_setup_trap() {
  trap bp_on_interrupt INT TERM
}

bp_clear_trap() {
  trap - INT TERM
}

# Begin a UX-wrapped operation: clear once, header, context, optional resume.
bp_begin() {
  local mode="$1"
  local allow_missing="${2:-0}"
  term_reset_clear_flag
  term_smart_clear
  events_start_op "$(echo "$mode" | tr '[:upper:]' '[:lower:]')"
  BP_START_EPOCH="$(date +%s 2>/dev/null || echo 0)"

  local dest="$TARGET"
  if [[ -d "$dest" ]]; then
    dest="$(cd "$dest" && pwd)"
    TARGET="$dest"
  fi

  context_load "$TARGET"
  if [[ "$allow_missing" -eq 0 ]]; then
    if ! context_require_markers "$TARGET" 0; then
      # init uses allow_missing=1; install may create into existing dirs with .git
      if [[ ! -d "$TARGET" ]]; then
        die "target does not exist: $TARGET"
      fi
    fi
  fi

  # Prefer state source for header; fall back after resolve.
  if [[ -z "${BP_CTX_SOURCE:-}" ]]; then
    BP_CTX_SOURCE="$(package_source_ref)"
  fi
  context_apply_header "$mode"
  render_header
  bp_setup_trap
  term_show_cursor

  if [[ "$mode" == "Install" || "$mode" == "Sync" ]]; then
    session_prompt_resume "$TARGET" || true
  fi
}

bp_resolve_source_for_op() {
  local dest="$TARGET"
  local state="${dest}/${STATE_FILE}"
  local source=""
  if [[ -f "$state" ]]; then
    source="$(read_state_field "$state" source "")"
  fi
  if [[ -z "$source" ]]; then
    source="$(package_source_ref)"
  fi
  BP_CTX_SOURCE="$source"
  BP_HEADER_SOURCE="$source"
  emit_phase_start "Validating source repository"
  if ! repo_resolve_root "$source" "$ROOT"; then
    events_finish_op "failed"
    render_summary_failure
    history_append || true
    session_mark_failed "$dest" || true
    term_show_cursor
    bp_clear_trap
    exit 1
  fi
  refresh_package_paths
  emit_phase_complete "Validating source repository"
}

bp_end_success() {
  local dest="${BP_CTX_ROOT:-$TARGET}"
  render_finalize_progress
  term_show_cursor
  bp_clear_trap
  events_finish_op "completed"
  local end_epoch duration
  end_epoch="$(date +%s 2>/dev/null || echo 0)"
  duration=""
  if [[ "$BP_START_EPOCH" =~ ^[0-9]+$ && "$end_epoch" =~ ^[0-9]+$ && "$BP_START_EPOCH" -gt 0 ]]; then
    duration="$((end_epoch - BP_START_EPOCH))s"
  fi
  local src_disp="${BP_CTX_SOURCE:-local}"
  if [[ -n "${BP_CTX_BRANCH:-}" && "$BP_CTX_BRANCH" != "unknown" ]]; then
    :
  fi
  # Prefer package branch for source@ref display when available
  local src_label
  src_label="$(term_redact_url "$src_disp")"
  if command -v git >/dev/null 2>&1 && [[ -d "${PACKAGE_ROOT}/.git" ]]; then
    local br
    br="$(git -C "$PACKAGE_ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ -n "$br" && "$br" != "HEAD" ]]; then
      src_label="${src_label}@${br}"
    fi
  fi
  if [[ "$BP_COUNT_FAILED" -gt 0 ]]; then
    events_finish_op "failed"
    render_summary_failure
    history_append || true
    session_mark_failed "$dest" || true
    exit 1
  fi
  render_summary_success "$src_label" "$duration"
  history_append || true
  session_complete "$dest" || true
}

bp_end_failure() {
  local dest="${BP_CTX_ROOT:-$TARGET}"
  render_finalize_progress
  term_show_cursor
  bp_clear_trap
  events_finish_op "failed"
  render_summary_failure
  history_append || true
  session_mark_failed "$dest" || true
}

need_file() {
  [[ -f "$1" ]] || die "missing required file: $1"
}

package_version() {
  if [[ -f "$VERSION_FILE" ]]; then
    tr -d '[:space:]' < "$VERSION_FILE"
  else
    echo "0.0.0"
  fi
}

resolve_blueprint_dir() {
  local name="$1"
  case "$name" in
    default) echo "${PACKAGE_ROOT}/blueprints/default" ;;
    engineering) echo "${PACKAGE_ROOT}/blueprints/engineering" ;;
    startup) echo "${PACKAGE_ROOT}/blueprints/startup" ;;
    *) die "unknown blueprint: $name (default|engineering|startup)" ;;
  esac
}

normalize_runtimes() {
  case "$1" in
    cursor) echo "cursor" ;;
    claude) echo "claude" ;;
    all) echo "cursor claude" ;;
    *) die "unknown runtime: $1 (cursor|claude|all)" ;;
  esac
}

runtime_available() {
  case "$1" in
    cursor)
      command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1
      ;;
    claude)
      command -v claude >/dev/null 2>&1
      ;;
    *) return 1 ;;
  esac
}

runtime_hint() {
  local name="$1"
  if runtime_available "$name"; then
    echo "detected on PATH"
  else
    echo "not detected on PATH (optional — install files only)"
  fi
}

# Interactive / auto selector when --runtime was not passed.
select_runtime() {
  if [[ "$RUNTIME_SET" -eq 1 ]]; then
    [[ -n "$RUNTIME" ]] || die "--runtime requires a value (cursor|claude|all)"
    return 0
  fi

  local cursor_hint claude_hint
  cursor_hint="$(runtime_hint cursor)"
  claude_hint="$(runtime_hint claude)"

  if [[ ! -t 0 || ! -t 1 ]]; then
    if runtime_available cursor && runtime_available claude; then
      RUNTIME="all"
    elif runtime_available claude; then
      RUNTIME="claude"
    elif runtime_available cursor; then
      RUNTIME="cursor"
    else
      die "no --runtime and no TTY; pass --runtime cursor|claude|all"
    fi
    emit_info "auto runtime (non-interactive): $RUNTIME"
    return 0
  fi

  cat <<EOF

Select AI runtime to install into the target project.
(Neither tool is required on PATH — this only chooses which files to write.)

  1) cursor   Cursor IDE        (.cursor/)  — ${cursor_hint}
  2) claude   Claude Code       (.claude/)  — ${claude_hint}
  3) all      Cursor + Claude   (both)
  4) cancel

EOF
  local choice=""
  while true; do
    printf 'Runtime [1-4]: '
    read -r choice || true
    case "$choice" in
      1|cursor|c) RUNTIME="cursor"; break ;;
      2|claude) RUNTIME="claude"; break ;;
      3|all|a) RUNTIME="all"; break ;;
      4|q|cancel|"") return 1 ;;
      *) warn "invalid choice: $choice (use 1-4)" ;;
    esac
  done
  emit_info "selected runtime: $RUNTIME"
  return 0
}

runtime_root_name() {
  case "$1" in
    cursor) echo ".cursor" ;;
    claude) echo ".claude" ;;
    *) die "unknown runtime: $1" ;;
  esac
}

copy_file() {
  local src="$1"
  local dest="$2"
  local mode="${3:-managed}" # managed | preserve | force

  if session_file_already_done "$dest"; then
    emit_file_skipped "$dest" "already completed in session"
    return 0
  fi

  if [[ ! -f "$src" ]]; then
    emit_warning "skip missing source: $src"
    emit_file_skipped "$dest" "missing source"
    return 0
  fi

  local existed=0
  [[ -f "$dest" ]] && existed=1

  if [[ -f "$dest" && "$mode" != "force" ]]; then
    if [[ "$mode" == "preserve" ]]; then
      emit_file_skipped "$dest" "preserve"
      return 0
    fi
    if [[ "$FORCE" -ne 1 ]]; then
      if grep -qF "$MARKER" "$dest" 2>/dev/null; then
        :
      else
        local conflict="${dest}.blueprint-conflict"
        if [[ "$DRY_RUN" -eq 1 ]]; then
          emit_file_conflict "$dest"
          return 0
        fi
        mkdir -p "$(dirname "$dest")"
        cp "$src" "$conflict"
        emit_file_conflict "$dest"
        return 0
      fi
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ "$existed" -eq 1 ]]; then
      emit_file_updated "$dest"
    else
      emit_file_added "$dest"
    fi
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  case "$dest" in
    *.md|*.mdc)
      if ! grep -qF "$MARKER" "$dest" 2>/dev/null; then
        printf '\n%s\n' "$MARKER" >> "$dest"
      fi
      ;;
  esac
  if [[ "$existed" -eq 1 ]]; then
    emit_file_updated "$dest"
  else
    emit_file_added "$dest"
  fi
}

install_skills_into() {
  local dest_skills="$1"
  local skill
  for skill in memory-system-protocol planning-execution-tracking docs-style skill-creator refactor-code; do
    if [[ -d "${PACKAGE_ROOT}/harness/skills/${skill}" ]]; then
      mkdir -p "${dest_skills}/${skill}"
      # shellcheck disable=SC2044
      for f in $(find "${PACKAGE_ROOT}/harness/skills/${skill}" -type f); do
        rel="${f#"${PACKAGE_ROOT}/harness/skills/${skill}/"}"
        copy_file "$f" "${dest_skills}/${skill}/${rel}"
      done
    fi
  done
}

install_rules_into() {
  local dest_rules="$1"
  local runtime="$2"
  local src_rule dest_name
  for src_rule in safety-rules.mdc planning-execution-tracking.mdc; do
    if [[ "$runtime" == "claude" ]]; then
      dest_name="${src_rule%.mdc}.md"
    else
      dest_name="$src_rule"
    fi
    copy_file "${PACKAGE_ROOT}/harness/rules/${src_rule}" "${dest_rules}/${dest_name}"
  done
}

install_commands_into() {
  local dest_commands="$1"
  shift
  local name
  for name in "$@"; do
    copy_file "${PACKAGE_ROOT}/harness/commands/${name}" "${dest_commands}/${name}"
  done
}

install_runtime() {
  local dest_root="$1"
  local runtime="$2"
  local rt_root
  rt_root="$(runtime_root_name "$runtime")"
  local base="${dest_root}/${rt_root}"

  install_commands_into "${base}/commands" start.md review.md commit.md
  install_rules_into "${base}/rules" "$runtime"
  install_skills_into "${base}/skills"
}

install_memory_templates_if_absent() {
  local dest_root="$1"
  local map=(
    "templates/memory/planning.md:PLANNING.md"
    "templates/memory/decisions.md:DECISIONS.md"
    "templates/memory/run-log.md:RUN_LOG.md"
    "templates/memory/hotcache.md:HOTCACHE.md"
    "templates/memory/anti-patterns.md:ANTI-PATTERNS.md"
    "templates/memory/learning.md:LEARNING.md"
  )
  local entry src dest
  for entry in "${map[@]}"; do
    src="${PACKAGE_ROOT}/${entry%%:*}"
    dest="${dest_root}/${entry##*:}"
    if [[ -f "$dest" ]]; then
      emit_file_skipped "$dest" "preserve local state"
    else
      copy_file "$src" "$dest" force
    fi
  done
}

install_compat_docs() {
  local dest_root="$1"
  copy_file "${PACKAGE_ROOT}/templates/entrypoints/AGENTS.md" "${dest_root}/AGENTS.md"
  copy_file "${PACKAGE_ROOT}/templates/entrypoints/CLAUDE.md" "${dest_root}/CLAUDE.md"
}

install_gitignore() {
  local dest_root="$1"
  local src="${PACKAGE_ROOT}/templates/gitignore"
  local dest="${dest_root}/.gitignore"
  local begin="# --- shared-agent-blueprints (managed) ---"
  local end="# --- end shared-agent-blueprints ---"

  need_file "$src"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
      emit_info "dry-run: would refresh managed .gitignore section in $dest"
    elif [[ -f "$dest" ]]; then
      emit_info "dry-run: would append managed .gitignore section to $dest"
    else
      emit_info "dry-run: would create $dest from templates/gitignore"
    fi
    return 0
  fi

  if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
    local tmp
    tmp="$(mktemp)"
    awk -v begin="$begin" -v end="$end" -v src="$src" '
      BEGIN {
        while ((getline line < src) > 0) { block = block line "\n" }
        close(src)
      }
      $0 == begin { print block; skip=1; next }
      skip && $0 == end { skip=0; next }
      skip { next }
      { print }
    ' "$dest" > "$tmp"
    mv "$tmp" "$dest"
    emit_file_updated "$dest"
    return 0
  fi

  if [[ -f "$dest" ]]; then
    printf '\n' >> "$dest"
    cat "$src" >> "$dest"
    emit_file_updated "$dest"
  else
    cp "$src" "$dest"
    emit_file_added "$dest"
  fi
}

install_gitlab_overlay_into() {
  local dest_commands="$1"
  local src="${PACKAGE_ROOT}/blueprints/engineering/gitlab/commands"
  local f
  for f in prerequisite.md pr.md fix-comment.md sync-dev.md; do
    copy_file "${src}/${f}" "${dest_commands}/${f}"
  done
}

package_source_ref() {
  local url=""
  if command -v git >/dev/null 2>&1 && [[ -d "${ROOT}/.git" || -f "${ROOT}/.git" ]]; then
    url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
  fi
  if [[ -n "$url" ]]; then
    case "$url" in
      git@github.com:*)
        url="https://github.com/${url#git@github.com:}"
        url="${url%.git}"
        ;;
      git@gitlab.com:*)
        url="https://gitlab.com/${url#git@gitlab.com:}"
        url="${url%.git}"
        ;;
      https://github.com/*|http://github.com/*|https://gitlab.com/*|http://gitlab.com/*)
        url="${url%.git}"
        ;;
      *.git)
        url="${url%.git}"
        ;;
    esac
    echo "$url"
    return 0
  fi
  if [[ -f "${ROOT}/manifest.yaml" ]]; then
    local name
    name="$(grep -E '^name:' "${ROOT}/manifest.yaml" | head -1 | awk '{print $2}')"
    if [[ -n "$name" ]]; then
      echo "$name"
      return 0
    fi
  fi
  echo "$ROOT"
}

write_state() {
  local dest_root="$1"
  local bp="$2"
  local runtimes_csv="$3"
  local ver
  ver="$(package_version)"
  local src_ref
  # Prefer URL-shaped context source when present; else portable package ref.
  if repo_is_fetchable "${BP_CTX_SOURCE:-}"; then
    src_ref="$BP_CTX_SOURCE"
  else
    src_ref="$(package_source_ref)"
  fi
  local out="${dest_root}/${STATE_FILE}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    emit_info "dry-run state: $out (source=$src_ref blueprint=$bp version=$ver runtimes=$runtimes_csv)"
    return 0
  fi
  local rt_yaml=""
  local r
  for r in $runtimes_csv; do
    rt_yaml="${rt_yaml}
  - ${r}"
  done
  cat > "$out" <<EOF
# Generated by ./blueprint — do not commit secrets here.
# source is a portable repo/package identity (URL triggers remote fetch/cache).
source: ${src_ref}
version: ${ver}
blueprint: ${bp}
overlay: ${OVERLAY:-null}
runtimes:${rt_yaml}
installed_at_utc: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
conflict_policy: preserve-local
EOF
  emit_file_added "$out"
}

read_state_field() {
  local state="$1"
  local field="$2"
  local default="${3:-}"
  if [[ -f "$state" ]]; then
    grep -E "^${field}:" "$state" | head -1 | awk '{print $2}'
  else
    echo "$default"
  fi
}

read_state_runtimes() {
  local state="$1"
  if [[ ! -f "$state" ]]; then
    echo ""
    return 0
  fi
  local has_runtimes_key=0
  local listed
  listed="$(awk '
    /^runtimes:/ { in_rt=1; print "__KEY__"; next }
    in_rt && /^  - / { gsub(/^  - /,""); print; next }
    in_rt && /^[^ ]/ { in_rt=0 }
  ' "$state")"
  if echo "$listed" | grep -q '^__KEY__$'; then
    has_runtimes_key=1
    listed="$(echo "$listed" | grep -v '^__KEY__$')"
  fi
  if [[ "$has_runtimes_key" -eq 1 ]]; then
    if [[ -z "$listed" ]]; then
      echo ""
    else
      echo "$listed" | tr '\n' ' ' | sed 's/[[:space:]]*$//'
    fi
    return 0
  fi
  local legacy
  legacy="$(read_state_field "$state" runtime_root "")"
  case "$legacy" in
    .cursor) echo "cursor" ;;
    .claude) echo "claude" ;;
    *) echo "" ;;
  esac
}

cmd_init() {
  bp_begin "Init" 1
  emit_phase_start "Detecting project"
  local dest_root="$TARGET"
  mkdir -p "$dest_root"
  emit_phase_complete "Detecting project"

  # Init always uses the local package that ships the CLI.
  PACKAGE_ROOT="$ROOT"
  refresh_package_paths

  emit_phase_start "Loading configuration"
  need_file "$MANIFEST"
  need_file "${PACKAGE_ROOT}/templates/entrypoints/AGENTS.md"
  need_file "${PACKAGE_ROOT}/templates/entrypoints/CLAUDE.md"
  need_file "${PACKAGE_ROOT}/templates/gitignore"
  emit_phase_complete "Loading configuration"

  session_start "$dest_root" "init" "$(package_source_ref)"
  emit_phase_start "Copying files"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root"
  if [[ ! -f "${dest_root}/${STATE_FILE}" ]]; then
    write_state "$dest_root" "default" ""
  else
    emit_file_skipped "${dest_root}/${STATE_FILE}" "preserve"
  fi
  if [[ ! -f "${dest_root}/${LOCAL_OVERRIDE}" && "$DRY_RUN" -eq 0 ]]; then
    cat > "${dest_root}/${LOCAL_OVERRIDE}" <<'EOF'
# Local overrides (not managed). Example:
# variables:
#   forge: github
#   integration_branch: develop
#   test_command: "uv run pytest"
EOF
    emit_file_added "${dest_root}/${LOCAL_OVERRIDE}"
  fi
  emit_phase_complete "Copying files"
  emit_info "init complete (shared entrypoints + memory; run install --runtime to project tool runtimes)"
  bp_end_success
}

cmd_install() {
  bp_begin "Install" 1
  local dest_root="$TARGET"
  mkdir -p "$dest_root"

  emit_phase_start "Detecting project"
  context_load "$dest_root"
  emit_phase_complete "Detecting project"

  bp_resolve_source_for_op

  emit_phase_start "Loading configuration"
  local bp_dir
  bp_dir="$(resolve_blueprint_dir "$BLUEPRINT")"
  need_file "${bp_dir}/blueprint.yaml"
  need_file "$MANIFEST"
  emit_phase_complete "Loading configuration"

  select_runtime || die "cancelled (no runtime selected)"

  local runtimes
  runtimes="$(normalize_runtimes "$RUNTIME")"

  session_start "$dest_root" "install" "${BP_CTX_SOURCE:-}"
  session_update_phase "$dest_root" "Copying files"

  emit_phase_start "Copying files"
  emit_info "installing blueprint: $BLUEPRINT -> $dest_root (runtimes: $runtimes)"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root"

  local rt
  for rt in $runtimes; do
    install_runtime "$dest_root" "$rt"
    local rt_root
    rt_root="$(runtime_root_name "$rt")"
    local rt_templates="${dest_root}/${rt_root}/templates"

    mkdir -p "$rt_templates"
    copy_file "${PACKAGE_ROOT}/templates/review-checklist.md" "${rt_templates}/review-checklist.md"
    copy_file "${PACKAGE_ROOT}/templates/adr.md" "${rt_templates}/adr.md"

    case "$BLUEPRINT" in
      engineering)
        copy_file "${PACKAGE_ROOT}/harness/commands/commit.md" "${dest_root}/${rt_root}/commands/commit.md"
        ;;
      startup)
        copy_file "${PACKAGE_ROOT}/templates/prd.md" "${rt_templates}/prd.md"
        ;;
    esac

    if [[ "$OVERLAY" == "gitlab" ]]; then
      install_gitlab_overlay_into "${dest_root}/${rt_root}/commands"
    fi
  done

  write_state "$dest_root" "$BLUEPRINT" "$runtimes"
  emit_phase_complete "Copying files"
  emit_phase_start "Writing run summary"
  emit_phase_complete "Writing run summary"
  bp_end_success
}

cmd_update() {
  bp_begin "Update" 1
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local current="unknown"
  local latest
  PACKAGE_ROOT="$ROOT"
  refresh_package_paths
  latest="$(package_version)"
  if [[ -f "$state" ]]; then
    current="$(read_state_field "$state" version unknown)"
  fi
  emit_info "installed version: ${current}"
  emit_info "package version:   ${latest}"
  if [[ "$current" == "$latest" ]]; then
    emit_info "already up to date"
    bp_end_success
    return 0
  fi
  emit_info "update plan:"
  emit_info "  1. re-run: ./blueprint sync --dry-run"
  emit_info "  2. review conflicts (*.blueprint-conflict)"
  emit_info "  3. apply:  ./blueprint sync"
  emit_info "  4. verify: ./blueprint doctor"
  bp_end_success
}

cmd_sync() {
  bp_begin "Sync" 0
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local bp="default"
  if [[ -f "$state" ]]; then
    bp="$(read_state_field "$state" blueprint default)"
    local ov
    ov="$(read_state_field "$state" overlay "")"
    if [[ -n "$ov" && "$ov" != "null" ]]; then
      OVERLAY="$ov"
    fi
    if [[ "$RUNTIME_SET" -eq 0 ]]; then
      local state_rts
      state_rts="$(read_state_runtimes "$state")"
      if [[ -n "$state_rts" ]]; then
        if [[ "$state_rts" == *"cursor"* && "$state_rts" == *"claude"* ]]; then
          RUNTIME="all"
        else
          RUNTIME="$(echo "$state_rts" | awk '{print $1}')"
        fi
        RUNTIME_SET=1
      else
        emit_error "no runtimes in ${STATE_FILE}; run: ./blueprint install <blueprint>"
        bp_end_failure
        exit 1
      fi
    fi
  elif [[ "$RUNTIME_SET" -eq 0 ]]; then
    emit_error "no ${STATE_FILE}; run: ./blueprint init && ./blueprint install <blueprint>"
    bp_end_failure
    exit 1
  fi
  BLUEPRINT="$bp"
  emit_info "syncing blueprint: $BLUEPRINT runtime=$RUNTIME (preserve-local)"

  # Re-enter install body without nested bp_begin.
  bp_resolve_source_for_op

  emit_phase_start "Loading configuration"
  local bp_dir
  bp_dir="$(resolve_blueprint_dir "$BLUEPRINT")"
  need_file "${bp_dir}/blueprint.yaml"
  need_file "$MANIFEST"
  emit_phase_complete "Loading configuration"

  select_runtime || die "cancelled (no runtime selected)"
  local runtimes
  runtimes="$(normalize_runtimes "$RUNTIME")"

  session_start "$dest_root" "sync" "${BP_CTX_SOURCE:-}"
  emit_phase_start "Copying files"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root"

  local rt
  for rt in $runtimes; do
    install_runtime "$dest_root" "$rt"
    local rt_root
    rt_root="$(runtime_root_name "$rt")"
    local rt_templates="${dest_root}/${rt_root}/templates"
    mkdir -p "$rt_templates"
    copy_file "${PACKAGE_ROOT}/templates/review-checklist.md" "${rt_templates}/review-checklist.md"
    copy_file "${PACKAGE_ROOT}/templates/adr.md" "${rt_templates}/adr.md"
    case "$BLUEPRINT" in
      engineering)
        copy_file "${PACKAGE_ROOT}/harness/commands/commit.md" "${dest_root}/${rt_root}/commands/commit.md"
        ;;
      startup)
        copy_file "${PACKAGE_ROOT}/templates/prd.md" "${rt_templates}/prd.md"
        ;;
    esac
    if [[ "$OVERLAY" == "gitlab" ]]; then
      install_gitlab_overlay_into "${dest_root}/${rt_root}/commands"
    fi
  done
  write_state "$dest_root" "$BLUEPRINT" "$runtimes"
  emit_phase_complete "Copying files"
  bp_end_success
}

cmd_doctor() {
  bp_begin "Doctor" 1
  local dest_root="$TARGET"
  local errors=0
  local package_mode=0
  local abs_dest abs_root
  abs_dest="$(cd "$dest_root" 2>/dev/null && pwd || echo "$dest_root")"
  abs_root="$(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")"
  if [[ "$abs_dest" == "$abs_root" ]]; then
    package_mode=1
  fi

  PACKAGE_ROOT="$ROOT"
  refresh_package_paths
  need_file "$MANIFEST"
  need_file "$VERSION_FILE"

  ui_header "Doctor"
  ui_kv "package" "$(package_version)"
  ui_kv "manifest" "$MANIFEST"
  if [[ "$package_mode" -eq 1 ]]; then
    ui_kv "mode" "package-source"
  else
    ui_kv "mode" "consumer-target"
  fi
  ui_kv "target" "$abs_dest"

  ui_section "Package"
  for d in blueprints/default harness/commands harness/rules harness/skills templates/memory templates/entrypoints prompts/system; do
    if [[ ! -e "${ROOT}/$d" ]]; then
      ui_fail "missing $d"
      errors=$((errors + 1))
    else
      ui_ok "$d"
    fi
  done
  if [[ -x "${ROOT}/blueprint" ]]; then
    ui_ok "blueprint (CLI)"
  else
    ui_fail "missing executable ./blueprint"
    errors=$((errors + 1))
  fi
  if [[ -d "${ROOT}/lib/blueprint" ]]; then
    ui_ok "lib/blueprint (UX modules)"
  else
    ui_fail "missing lib/blueprint"
    errors=$((errors + 1))
  fi

  if [[ "$package_mode" -eq 1 ]]; then
    ui_section "Package hygiene"
    for bad in .cursor .claude PLANNING.md DECISIONS.md RUN_LOG.md HOTCACHE.md LEARNING.md ANTI-PATTERNS.md; do
      if [[ -e "${dest_root}/${bad}" ]]; then
        ui_fail "should not contain consumer artifact: $bad"
        errors=$((errors + 1))
      else
        ui_ok "no $bad"
      fi
    done
    ui_section "Entrypoints"
    for f in AGENTS.md CLAUDE.md; do
      if [[ -f "${dest_root}/$f" ]]; then
        ui_ok "$f"
      else
        ui_fail "missing $f"
        errors=$((errors + 1))
      fi
    done
  else
    local state="${dest_root}/${STATE_FILE}"
    local has_agents=0 has_claude=0 has_state=0
    [[ -f "${dest_root}/AGENTS.md" ]] && has_agents=1
    [[ -f "${dest_root}/CLAUDE.md" ]] && has_claude=1
    [[ -f "$state" ]] && has_state=1

    ui_section "Consumer install"
    if [[ "$has_state" -eq 0 && "$has_agents" -eq 0 ]]; then
      ui_fail "not initialized"
      printf '\n'
      ui_next "menu → 1) init"
      ui_next "menu → 2) install  (blueprint + runtime)"
      ui_next "menu → 5) doctor   (re-check)"
      printf '\n'
      ui_info "CLI: ./blueprint init --target ${abs_dest}"
      ui_info "CLI: ./blueprint install default --runtime all --target ${abs_dest}"
      errors=$((errors + 1))
    else
      if [[ "$has_state" -eq 1 ]]; then
        ui_ok "${STATE_FILE}"
      else
        ui_fail "missing ${STATE_FILE}  (run init, then install)"
        errors=$((errors + 1))
      fi
      if [[ "$has_agents" -eq 1 ]]; then
        ui_ok "AGENTS.md"
      else
        ui_fail "missing AGENTS.md  (run init)"
        errors=$((errors + 1))
      fi
      if [[ "$has_claude" -eq 1 ]]; then
        ui_ok "CLAUDE.md"
      else
        ui_fail "missing CLAUDE.md  (run init)"
        errors=$((errors + 1))
      fi

      ui_section "Runtimes"
      local declared
      declared="$(read_state_runtimes "$state")"
      if [[ -z "$declared" ]]; then
        ui_fail "no tool runtime installed yet"
        ui_next "menu → 2) install"
        errors=$((errors + 1))
      else
        local found_runtime=0
        local rt rt_root
        for rt in cursor claude; do
          rt_root="$(runtime_root_name "$rt")"
          if [[ -d "${dest_root}/${rt_root}" ]]; then
            if echo " $declared " | grep -q " $rt "; then
              ui_ok "${rt_root}  (declared)"
              found_runtime=1
            else
              ui_info "${rt_root} present but not declared in state"
            fi
          else
            if echo " $declared " | grep -q " $rt "; then
              ui_fail "${rt_root} declared but missing  (re-run install)"
              errors=$((errors + 1))
            else
              ui_skip "${rt_root} not installed"
            fi
          fi
        done
        if [[ "$found_runtime" -eq 0 ]]; then
          ui_fail "no declared tool runtime directory found"
          errors=$((errors + 1))
        fi
      fi
    fi
  fi

  ui_section "Tooling"
  if command -v glab >/dev/null 2>&1; then
    ui_ok "glab"
  else
    ui_skip "glab not found (only needed for GitLab overlay)"
  fi
  if command -v gh >/dev/null 2>&1; then
    ui_ok "gh"
  else
    ui_skip "gh not found (only needed for GitHub workflows)"
  fi

  if [[ "$errors" -gt 0 ]]; then
    ui_footer_fail "$errors"
    events_finish_op "failed"
    history_append || true
    term_show_cursor
    bp_clear_trap
    exit 1
  fi
  ui_footer_ok
  bp_end_success
}

usage() {
  cat <<'EOF'
Usage: blueprint [<command>] [blueprint] [flags]
       ./blueprint [<command>] [blueprint] [flags]

Commands:
  (none) / menu        Interactive menu (TTY)
  init                 Write AGENTS.md, CLAUDE.md, memory, .gitignore (no tool runtime)
  install <blueprint>  Install blueprint into --target runtimes
  update               Show update plan vs package VERSION
  sync                 Re-apply installed blueprint with preserve-local
  doctor               Validate package + target install health

Blueprints:
  default | engineering | startup

Flags:
  --overlay gitlab     Install GitLab/glab command overlay
  --runtime NAME       cursor | claude | all
                       (omit to get an interactive selector; both tools optional)
  --target PATH        Consumer project root (any local path; not this package)
  --dry-run            Print actions without writing
  --force              Overwrite unmanaged files

Install on PATH (optional):
  ln -s /path/to/agent-harness-blueprint/blueprint /usr/local/bin/blueprint

Remote source:
  When .agent-blueprint.yaml source is a git URL, install/sync clone or update
  a cache under $XDG_CACHE_HOME/blueprint/repos/ then copy from that cache.
EOF
}

prompt_line() {
  local label="$1"
  local default="${2:-}"
  local value=""
  if [[ -n "$default" ]]; then
    printf '%s\n  default: %s\n> ' "$label" "$default" >&2
  else
    printf '%s\n> ' "$label" >&2
  fi
  read -r value || true
  value="${value//$'\r'/}"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [[ -z "$value" ]]; then
    printf '%s\n' "$default"
  else
    printf '%s\n' "$value"
  fi
}

expand_path() {
  local raw="$1"
  if [[ "$raw" == "~" ]]; then
    raw="$HOME"
  elif [[ "$raw" == "~/"* ]]; then
    raw="${HOME}/${raw:2}"
  fi
  if [[ "$raw" == /* ]]; then
    printf '%s\n' "$raw"
  else
    printf '%s\n' "$(pwd)/$raw"
  fi
}

paths_equal() {
  local a b
  a="$(cd "$1" 2>/dev/null && pwd || echo "$1")"
  b="$(cd "$2" 2>/dev/null && pwd || echo "$2")"
  [[ "$a" == "$b" ]]
}

select_blueprint() {
  cat <<'EOF'

Select blueprint:
  1) default       Core harness (start/review, safety, skills)
  2) engineering   + commit / refactor / ADR
  3) startup       + PRD/ADR templates
  4) cancel

EOF
  local choice=""
  while true; do
    printf 'Blueprint [1-4]: '
    read -r choice || true
    case "$choice" in
      1|default|d) BLUEPRINT="default"; break ;;
      2|engineering|e) BLUEPRINT="engineering"; break ;;
      3|startup|s) BLUEPRINT="startup"; break ;;
      4|q|cancel|"") return 1 ;;
      *) warn "invalid choice: $choice (use 1-4)" ;;
    esac
  done
  emit_info "selected blueprint: $BLUEPRINT"
  return 0
}

select_overlay() {
  cat <<'EOF'

Select forge overlay (optional):
  1) none      No forge overlay
  2) gitlab    GitLab / glab MR playbooks
  3) cancel

EOF
  local choice=""
  while true; do
    printf 'Overlay [1-3]: '
    read -r choice || true
    case "$choice" in
      1|none|n|"") OVERLAY=""; break ;;
      2|gitlab|g) OVERLAY="gitlab"; break ;;
      3|q|cancel) return 1 ;;
      *) warn "invalid choice: $choice (use 1-3)" ;;
    esac
  done
  if [[ -n "$OVERLAY" ]]; then
    emit_info "selected overlay: $OVERLAY"
  else
    emit_info "selected overlay: none"
  fi
  return 0
}

menu_prompt_target() {
  local _required="${1:-0}"
  local raw="" resolved=""
  local default_hint="$TARGET"

  if [[ -z "$default_hint" || "$default_hint" == "." ]] || paths_equal "$default_hint" "$ROOT"; then
    default_hint=""
  fi

  while true; do
    # Banner on every prompt attempt (first step of ./blueprint).
    menu_splash "$(pwd)"
    cat <<EOF
  Consumer project target
  Destination can be any local folder (not this blueprint package).

  Examples:
    ~/Developer/my-app
    /tmp/demo-consumer

  Package (do not use as target):
    $(term_home_path "$ROOT")

EOF
    if [[ -n "$default_hint" ]]; then
      raw="$(prompt_line "Enter consumer project path (absolute or ~/…)" "$default_hint")"
    else
      raw="$(prompt_line "Enter consumer project path (absolute or ~/…)" "")"
    fi

    if [[ -z "$raw" ]]; then
      warn "target path is required — use a path outside this blueprint repo"
      continue
    fi

    raw="${raw%%$'\n'*}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"

    resolved="$(expand_path "$raw")"
    emit_info "checking path: $resolved"
    if [[ -d "$resolved" ]]; then
      resolved="$(cd "$resolved" && pwd)"
    elif [[ -d "$(dirname "$resolved")" ]]; then
      resolved="$(cd "$(dirname "$resolved")" && pwd)/$(basename "$resolved")"
    fi

    if paths_equal "$resolved" "$ROOT"; then
      warn "that path IS this blueprint package — pick a different consumer project"
      continue
    fi

    printf '\n  Resolved target:\n    %s\n\n' "$resolved" >&2
    if [[ -d "$resolved" ]]; then
      printf 'Use this existing project? [Y/n]: ' >&2
      local ok=""
      read -r ok || true
      case "$ok" in
        ""|y|Y|yes|YES) ;;
        *) continue ;;
      esac
    else
      printf 'Path does not exist yet. Create it? [y/N]: ' >&2
      local create=""
      read -r create || true
      case "$create" in
        y|Y|yes|YES)
          mkdir -p "$resolved" || {
            warn "could not create: $resolved"
            continue
          }
          emit_info "created: $resolved"
          ;;
        *)
          warn "enter an existing path, or confirm create"
          continue
          ;;
      esac
    fi

    TARGET="$resolved"
    emit_info "target locked: $TARGET"
    return 0
  done
}

menu_run() {
  set +e
  (
    set -e
    "$@"
  )
  local rc=$?
  set -e
  term_show_cursor
  printf '\n'
  if [[ $rc -ne 0 ]]; then
    printf '  %s✗%s  Action failed (exit %s)\n' "$(term_color red)$(term_color bold)" "$(term_color reset)" "$rc" >&2
  else
    printf '  %s✓%s  Action complete\n' "$(term_color green)$(term_color bold)" "$(term_color reset)"
  fi
  printf '\n  %sPress Enter to return to menu…%s ' "$(term_color dim)" "$(term_color reset)"
  read -r _ || true
}

menu_draw() {
  term_reset_clear_flag
  term_smart_clear
  term_show_cursor
  render_menu "$(package_version)" "$TARGET"
}

# First-frame splash: clear + banner before any prompts.
menu_splash() {
  local path_hint="${1:-.}"
  term_reset_clear_flag
  term_smart_clear
  term_show_cursor
  render_banner "$(package_version)" "shared agent blueprints · install · sync" "$(term_home_path "$path_hint")"
}

cmd_menu() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    usage
    die "interactive menu requires a TTY; pass a command (init|install|…)"
  fi

  # Target prompt clears and shows banner as the first CLI frame.
  menu_prompt_target 1

  while true; do
    menu_draw
    local choice=""
    read -r choice || true
    case "$choice" in
      1|init)
        menu_run cmd_init
        ;;
      2|install)
        select_blueprint || continue
        select_overlay || continue
        RUNTIME_SET=0
        RUNTIME=""
        select_runtime || continue
        RUNTIME_SET=1
        menu_run cmd_install
        ;;
      3|sync)
        menu_run cmd_sync
        ;;
      4|update)
        menu_run cmd_update
        ;;
      5|doctor)
        menu_run cmd_doctor
        ;;
      6|target|set)
        menu_splash "$(pwd)"
        menu_prompt_target 1
        ;;
      7|help|h)
        term_reset_clear_flag
        term_smart_clear
        render_banner "$(package_version)" "help" "$(term_home_path "$TARGET")"
        usage
        printf '\n  %sPress Enter to return to menu…%s ' "$(term_color dim)" "$(term_color reset)"
        read -r _ || true
        ;;
      8|q|quit|exit|"")
        term_reset_clear_flag
        term_smart_clear
        printf '  %sbye%s\n' "$(term_color dim)" "$(term_color reset)"
        return 0
        ;;
      *)
        warn "invalid choice: $choice (use 1-8)"
        sleep 0.6 2>/dev/null || true
        ;;
    esac
  done
}

case "$cmd" in
  menu|interactive) cmd_menu ;;
  init) cmd_init ;;
  install) cmd_install ;;
  update) cmd_update ;;
  sync) cmd_sync ;;
  doctor) cmd_doctor ;;
  -h|--help|help) usage ;;
  "")
    if [[ -t 0 && -t 1 ]]; then
      cmd_menu
    else
      usage
      exit 2
    fi
    ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
