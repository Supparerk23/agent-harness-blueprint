#!/usr/bin/env bash
# Lightweight package-manager style CLI for shared-agent-blueprints.
# Usage: scripts/agent {init|install|update|sync|doctor} [blueprint] [--overlay NAME] [--runtime NAME] [--dry-run] [--force]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSION_FILE="${ROOT}/VERSION"
MANIFEST="${ROOT}/manifest.yaml"
STATE_FILE=".agent-blueprint.yaml"
LOCAL_OVERRIDE=".agent-blueprint.local.yaml"
MARKER="<!-- managed-by: shared-agent-blueprints -->"

cmd="${1:-}"
shift || true

BLUEPRINT="default"
OVERLAY=""
RUNTIME=""
RUNTIME_SET=0
DRY_RUN=0
FORCE=0
TARGET="."

while [[ $# -gt 0 ]]; do
  case "$1" in
    --overlay) OVERLAY="${2:-}"; shift 2 ;;
    --runtime)
      RUNTIME="${2:-}"
      RUNTIME_SET=1
      shift 2
      ;;
    --dry-run) DRY_RUN=1; shift ;;
    --force) FORCE=1; shift ;;
    --target) TARGET="${2:-.}"; shift 2 ;;
    -*)
      echo "unknown flag: $1" >&2
      exit 2
      ;;
    *)
      BLUEPRINT="$1"
      shift
      ;;
  esac
done

log() { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

need_file() {
  [[ -f "$1" ]] || die "missing required file: $1"
}

package_version() {
  if [[ -f "$VERSION_FILE" ]]; then
    tr -d '[:space:]' < "$VERSION_FILE"
  else
    echo "0.0.0"
  fi
}

resolve_blueprint_dir() {
  local name="$1"
  case "$name" in
    default) echo "${ROOT}/blueprints/default" ;;
    engineering) echo "${ROOT}/blueprints/engineering" ;;
    startup) echo "${ROOT}/blueprints/startup" ;;
    *) die "unknown blueprint: $name (default|engineering|startup)" ;;
  esac
}

normalize_runtimes() {
  case "$1" in
    cursor) echo "cursor" ;;
    claude) echo "claude" ;;
    all) echo "cursor claude" ;;
    *) die "unknown runtime: $1 (cursor|claude|all)" ;;
  esac
}

runtime_available() {
  case "$1" in
    cursor)
      command -v cursor >/dev/null 2>&1 || command -v cursor-agent >/dev/null 2>&1
      ;;
    claude)
      command -v claude >/dev/null 2>&1
      ;;
    *) return 1 ;;
  esac
}

runtime_hint() {
  local name="$1"
  if runtime_available "$name"; then
    echo "detected on PATH"
  else
    echo "not detected on PATH (optional — install files only)"
  fi
}

# Interactive / auto selector when --runtime was not passed.
# Cursor and Claude are both optional; pick what this machine needs.
select_runtime() {
  if [[ "$RUNTIME_SET" -eq 1 ]]; then
    [[ -n "$RUNTIME" ]] || die "--runtime requires a value (cursor|claude|all)"
    return 0
  fi

  local cursor_hint claude_hint
  cursor_hint="$(runtime_hint cursor)"
  claude_hint="$(runtime_hint claude)"

  # Non-interactive (CI / piped): auto-pick from PATH, never assume Cursor.
  if [[ ! -t 0 || ! -t 1 ]]; then
    if runtime_available cursor && runtime_available claude; then
      RUNTIME="all"
    elif runtime_available claude; then
      RUNTIME="claude"
    elif runtime_available cursor; then
      RUNTIME="cursor"
    else
      die "no --runtime and no TTY; pass --runtime cursor|claude|all"
    fi
    log "auto runtime (non-interactive): $RUNTIME"
    return 0
  fi

  cat <<EOF

Select AI runtime to install into the target project.
(Neither tool is required on PATH — this only chooses which files to write.)

  1) cursor   Cursor IDE        (.cursor/)  — ${cursor_hint}
  2) claude   Claude Code       (.claude/)  — ${claude_hint}
  3) all      Cursor + Claude   (both)
  4) cancel

EOF
  local choice=""
  while true; do
    printf 'Runtime [1-4]: '
    read -r choice || true
    case "$choice" in
      1|cursor|c) RUNTIME="cursor"; break ;;
      2|claude) RUNTIME="claude"; break ;;
      3|all|a) RUNTIME="all"; break ;;
      4|q|cancel|"") die "cancelled (no runtime selected)" ;;
      *) warn "invalid choice: $choice (use 1-4)" ;;
    esac
  done
  log "selected runtime: $RUNTIME"
}

runtime_root_name() {
  case "$1" in
    cursor) echo ".cursor" ;;
    claude) echo ".claude" ;;
    *) die "unknown runtime: $1" ;;
  esac
}

copy_file() {
  local src="$1"
  local dest="$2"
  local mode="${3:-managed}" # managed | preserve | force

  if [[ ! -f "$src" ]]; then
    warn "skip missing source: $src"
    return 0
  fi

  if [[ -f "$dest" && "$mode" != "force" ]]; then
    if [[ "$mode" == "preserve" ]]; then
      log "preserve: $dest"
      return 0
    fi
    if [[ "$FORCE" -ne 1 ]]; then
      if grep -qF "$MARKER" "$dest" 2>/dev/null; then
        :
      else
        # Local/unmanaged file: write conflict sibling instead of overwriting
        local conflict="${dest}.blueprint-conflict"
        if [[ "$DRY_RUN" -eq 1 ]]; then
          log "dry-run conflict: would write $conflict (keep $dest)"
          return 0
        fi
        mkdir -p "$(dirname "$dest")"
        cp "$src" "$conflict"
        warn "conflict: kept $dest; wrote candidate to $conflict"
        return 0
      fi
    fi
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run copy: $src -> $dest"
    return 0
  fi

  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  # Append managed marker for markdown-like files once
  case "$dest" in
    *.md|*.mdc)
      if ! grep -qF "$MARKER" "$dest" 2>/dev/null; then
        printf '\n%s\n' "$MARKER" >> "$dest"
      fi
      ;;
  esac
  log "installed: $dest"
}

install_skills_into() {
  local dest_skills="$1"
  local skill
  for skill in memory-system-protocol planning-execution-tracking docs-style skill-creator refactor-code; do
    if [[ -d "${ROOT}/harness/skills/${skill}" ]]; then
      mkdir -p "${dest_skills}/${skill}"
      # shellcheck disable=SC2044
      for f in $(find "${ROOT}/harness/skills/${skill}" -type f); do
        rel="${f#"${ROOT}/harness/skills/${skill}/"}"
        copy_file "$f" "${dest_skills}/${skill}/${rel}"
      done
    fi
  done
}

install_rules_into() {
  local dest_rules="$1"
  local runtime="$2"
  local src_rule dest_name
  for src_rule in safety-rules.mdc planning-execution-tracking.mdc; do
    if [[ "$runtime" == "claude" ]]; then
      dest_name="${src_rule%.mdc}.md"
    else
      dest_name="$src_rule"
    fi
    copy_file "${ROOT}/harness/rules/${src_rule}" "${dest_rules}/${dest_name}"
  done
}

install_commands_into() {
  local dest_commands="$1"
  shift
  local name
  for name in "$@"; do
    copy_file "${ROOT}/harness/commands/${name}" "${dest_commands}/${name}"
  done
}

install_runtime() {
  local dest_root="$1"
  local runtime="$2"
  local rt_root
  rt_root="$(runtime_root_name "$runtime")"
  local base="${dest_root}/${rt_root}"

  install_commands_into "${base}/commands" start.md review.md commit.md
  install_rules_into "${base}/rules" "$runtime"
  install_skills_into "${base}/skills"
}

install_memory_templates_if_absent() {
  local dest_root="$1"
  local map=(
    "templates/memory/planning.md:PLANNING.md"
    "templates/memory/decisions.md:DECISIONS.md"
    "templates/memory/run-log.md:RUN_LOG.md"
    "templates/memory/hotcache.md:HOTCACHE.md"
    "templates/memory/anti-patterns.md:ANTI-PATTERNS.md"
    "templates/memory/learning.md:LEARNING.md"
  )
  local entry src dest
  for entry in "${map[@]}"; do
    src="${ROOT}/${entry%%:*}"
    dest="${dest_root}/${entry##*:}"
    if [[ -f "$dest" ]]; then
      log "preserve local state: $dest"
    else
      copy_file "$src" "$dest" force
    fi
  done
}

install_compat_docs() {
  local dest_root="$1"
  copy_file "${ROOT}/templates/entrypoints/AGENTS.md" "${dest_root}/AGENTS.md"
  copy_file "${ROOT}/templates/entrypoints/CLAUDE.md" "${dest_root}/CLAUDE.md"
}

# Merge consumer .gitignore fragment from templates/gitignore (idempotent).
install_gitignore() {
  local dest_root="$1"
  local src="${ROOT}/templates/gitignore"
  local dest="${dest_root}/.gitignore"
  local begin="# --- shared-agent-blueprints (managed) ---"
  local end="# --- end shared-agent-blueprints ---"

  need_file "$src"

  if [[ "$DRY_RUN" -eq 1 ]]; then
    if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
      log "dry-run: would refresh managed .gitignore section in $dest"
    elif [[ -f "$dest" ]]; then
      log "dry-run: would append managed .gitignore section to $dest"
    else
      log "dry-run: would create $dest from templates/gitignore"
    fi
    return 0
  fi

  if [[ -f "$dest" ]] && grep -qF "$begin" "$dest" 2>/dev/null; then
    # Refresh managed block in place (awk between markers)
    local tmp
    tmp="$(mktemp)"
    awk -v begin="$begin" -v end="$end" -v src="$src" '
      BEGIN {
        while ((getline line < src) > 0) { block = block line "\n" }
        close(src)
      }
      $0 == begin { print block; skip=1; next }
      skip && $0 == end { skip=0; next }
      skip { next }
      { print }
    ' "$dest" > "$tmp"
    mv "$tmp" "$dest"
    log "updated managed section: $dest"
    return 0
  fi

  if [[ -f "$dest" ]]; then
    printf '\n' >> "$dest"
    cat "$src" >> "$dest"
    log "appended managed section: $dest"
  else
    cp "$src" "$dest"
    log "installed: $dest"
  fi
}

install_gitlab_overlay_into() {
  local dest_commands="$1"
  local src="${ROOT}/blueprints/engineering/gitlab/commands"
  local f
  for f in prerequisite.md pr.md fix-comment.md sync-dev.md; do
    copy_file "${src}/${f}" "${dest_commands}/${f}"
  done
}

write_state() {
  local dest_root="$1"
  local bp="$2"
  local runtimes_csv="$3"
  local ver
  ver="$(package_version)"
  local out="${dest_root}/${STATE_FILE}"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "dry-run state: $out (blueprint=$bp version=$ver runtimes=$runtimes_csv)"
    return 0
  fi
  # YAML list from space-separated runtimes
  local rt_yaml=""
  local r
  for r in $runtimes_csv; do
    rt_yaml="${rt_yaml}
  - ${r}"
  done
  cat > "$out" <<EOF
# Generated by scripts/agent — do not commit secrets here.
source: ${ROOT}
version: ${ver}
blueprint: ${bp}
overlay: ${OVERLAY:-null}
runtimes:${rt_yaml}
installed_at_utc: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
conflict_policy: preserve-local
EOF
  log "wrote: $out"
}

read_state_field() {
  local state="$1"
  local field="$2"
  local default="${3:-}"
  if [[ -f "$state" ]]; then
    grep -E "^${field}:" "$state" | head -1 | awk '{print $2}'
  else
    echo "$default"
  fi
}

read_state_runtimes() {
  local state="$1"
  if [[ ! -f "$state" ]]; then
    echo ""
    return 0
  fi
  # Prefer explicit runtimes list; fall back to legacy runtime_root
  local has_runtimes_key=0
  local listed
  listed="$(awk '
    /^runtimes:/ { in_rt=1; print "__KEY__"; next }
    in_rt && /^  - / { gsub(/^  - /,""); print; next }
    in_rt && /^[^ ]/ { in_rt=0 }
  ' "$state")"
  if echo "$listed" | grep -q '^__KEY__$'; then
    has_runtimes_key=1
    listed="$(echo "$listed" | grep -v '^__KEY__$')"
  fi
  if [[ "$has_runtimes_key" -eq 1 ]]; then
    # May be empty after init (no tool runtime yet)
    if [[ -z "$listed" ]]; then
      echo ""
    else
      echo "$listed" | tr '\n' ' ' | sed 's/[[:space:]]*$//'
    fi
    return 0
  fi
  local legacy
  legacy="$(read_state_field "$state" runtime_root "")"
  case "$legacy" in
    .cursor) echo "cursor" ;;
    .claude) echo "claude" ;;
    *) echo "" ;;
  esac
}

cmd_init() {
  local dest_root="$TARGET"
  mkdir -p "$dest_root"
  need_file "$MANIFEST"
  need_file "${ROOT}/templates/entrypoints/AGENTS.md"
  need_file "${ROOT}/templates/entrypoints/CLAUDE.md"
  need_file "${ROOT}/templates/gitignore"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root"
  if [[ ! -f "${dest_root}/${STATE_FILE}" ]]; then
    write_state "$dest_root" "default" ""
  else
    log "preserve: ${dest_root}/${STATE_FILE}"
  fi
  if [[ ! -f "${dest_root}/${LOCAL_OVERRIDE}" && "$DRY_RUN" -eq 0 ]]; then
    cat > "${dest_root}/${LOCAL_OVERRIDE}" <<'EOF'
# Local overrides (not managed). Example:
# variables:
#   forge: github
#   integration_branch: develop
#   test_command: "uv run pytest"
EOF
    log "wrote: ${dest_root}/${LOCAL_OVERRIDE}"
  fi
  log "init complete (shared entrypoints + memory; run install --runtime to project tool runtimes)"
}

cmd_install() {
  local dest_root="$TARGET"
  local bp_dir
  bp_dir="$(resolve_blueprint_dir "$BLUEPRINT")"
  need_file "${bp_dir}/blueprint.yaml"
  need_file "$MANIFEST"

  select_runtime

  local runtimes
  runtimes="$(normalize_runtimes "$RUNTIME")"

  log "installing blueprint: $BLUEPRINT -> $dest_root (runtimes: $runtimes)"
  install_compat_docs "$dest_root"
  install_memory_templates_if_absent "$dest_root"
  install_gitignore "$dest_root"

  local rt
  for rt in $runtimes; do
    install_runtime "$dest_root" "$rt"
    local rt_root
    rt_root="$(runtime_root_name "$rt")"
    local rt_templates="${dest_root}/${rt_root}/templates"

    # Agent-workflow templates stay inside the runtime (not project root).
    mkdir -p "$rt_templates"
    copy_file "${ROOT}/templates/review-checklist.md" "${rt_templates}/review-checklist.md"
    copy_file "${ROOT}/templates/adr.md" "${rt_templates}/adr.md"

    case "$BLUEPRINT" in
      engineering)
        copy_file "${ROOT}/harness/commands/commit.md" "${dest_root}/${rt_root}/commands/commit.md"
        ;;
      startup)
        copy_file "${ROOT}/templates/prd.md" "${rt_templates}/prd.md"
        ;;
    esac

    if [[ "$OVERLAY" == "gitlab" ]]; then
      install_gitlab_overlay_into "${dest_root}/${rt_root}/commands"
    fi
  done

  write_state "$dest_root" "$BLUEPRINT" "$runtimes"
  log "install complete"
}

cmd_update() {
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local current="unknown"
  local latest
  latest="$(package_version)"
  if [[ -f "$state" ]]; then
    current="$(read_state_field "$state" version unknown)"
  fi
  log "installed version: ${current}"
  log "package version:   ${latest}"
  if [[ "$current" == "$latest" ]]; then
    log "already up to date"
    return 0
  fi
  log "update plan:"
  log "  1. re-run: scripts/agent sync --dry-run"
  log "  2. review conflicts (*.blueprint-conflict)"
  log "  3. apply:  scripts/agent sync"
  log "  4. verify: scripts/agent doctor"
}

cmd_sync() {
  local dest_root="$TARGET"
  local state="${dest_root}/${STATE_FILE}"
  local bp="default"
  if [[ -f "$state" ]]; then
    bp="$(read_state_field "$state" blueprint default)"
    local ov
    ov="$(read_state_field "$state" overlay "")"
    if [[ -n "$ov" && "$ov" != "null" ]]; then
      OVERLAY="$ov"
    fi
    # Re-apply previously installed runtimes unless caller passed --runtime.
    if [[ "$RUNTIME_SET" -eq 0 ]]; then
      local state_rts
      state_rts="$(read_state_runtimes "$state")"
      if [[ -n "$state_rts" ]]; then
        if [[ "$state_rts" == *"cursor"* && "$state_rts" == *"claude"* ]]; then
          RUNTIME="all"
        else
          RUNTIME="$(echo "$state_rts" | awk '{print $1}')"
        fi
        RUNTIME_SET=1
      else
        die "no runtimes in ${STATE_FILE}; run: scripts/agent install <blueprint>"
      fi
    fi
  elif [[ "$RUNTIME_SET" -eq 0 ]]; then
    die "no ${STATE_FILE}; run: scripts/agent init && scripts/agent install <blueprint>"
  fi
  BLUEPRINT="$bp"
  log "syncing blueprint: $BLUEPRINT runtime=$RUNTIME (preserve-local)"
  cmd_install
}

cmd_doctor() {
  local dest_root="$TARGET"
  local errors=0
  local package_mode=0
  # Resolve absolute paths for comparison when possible
  local abs_dest abs_root
  abs_dest="$(cd "$dest_root" 2>/dev/null && pwd || echo "$dest_root")"
  abs_root="$(cd "$ROOT" 2>/dev/null && pwd || echo "$ROOT")"
  if [[ "$abs_dest" == "$abs_root" ]]; then
    package_mode=1
  fi

  need_file "$MANIFEST"
  need_file "$VERSION_FILE"
  log "package: $(package_version)"
  log "manifest: $MANIFEST"
  if [[ "$package_mode" -eq 1 ]]; then
    log "mode: package-source (consumer runtime not expected here)"
  else
    log "mode: consumer-target"
  fi

  for d in blueprints/default harness/commands harness/rules harness/skills templates/memory templates/entrypoints prompts/system scripts; do
    if [[ ! -e "${ROOT}/$d" ]]; then
      warn "missing package path: $d"
      errors=$((errors + 1))
    else
      log "ok: $d"
    fi
  done

  # Package must not contain adoption/runtime artifacts
  if [[ "$package_mode" -eq 1 ]]; then
    for bad in .cursor .claude PLANNING.md DECISIONS.md RUN_LOG.md HOTCACHE.md LEARNING.md ANTI-PATTERNS.md; do
      if [[ -e "${dest_root}/${bad}" ]]; then
        warn "package should not contain consumer artifact: $bad"
        errors=$((errors + 1))
      else
        log "ok: absent consumer artifact $bad"
      fi
    done
  else
    local state="${dest_root}/${STATE_FILE}"
    if [[ -f "$state" ]]; then
      log "ok: ${STATE_FILE}"
    else
      warn "no ${STATE_FILE} (run init/install)"
      errors=$((errors + 1))
    fi

    local declared
    declared="$(read_state_runtimes "$state")"
    if [[ -z "$declared" ]]; then
      warn "no tool runtime installed yet (run: scripts/agent install <blueprint> --runtime all)"
      errors=$((errors + 1))
    else
      local found_runtime=0
      local rt rt_root
      for rt in cursor claude; do
        rt_root="$(runtime_root_name "$rt")"
        if [[ -d "${dest_root}/${rt_root}" ]]; then
          if echo " $declared " | grep -q " $rt "; then
            log "ok: runtime ${rt_root} present (declared)"
            found_runtime=1
          else
            log "info: runtime ${rt_root} present but not declared in state"
          fi
        else
          if echo " $declared " | grep -q " $rt "; then
            warn "declared runtime ${rt_root} missing (run: scripts/agent install <blueprint> --runtime ${rt}|all)"
            errors=$((errors + 1))
          else
            log "info: runtime ${rt_root} not installed"
          fi
        fi
      done
      if [[ "$found_runtime" -eq 0 ]]; then
        warn "no declared tool runtime directory found"
        errors=$((errors + 1))
      fi
    fi
  fi

  for f in AGENTS.md CLAUDE.md; do
    if [[ -f "${dest_root}/$f" ]]; then
      log "ok: $f"
    else
      warn "missing compatibility file: $f"
      errors=$((errors + 1))
    fi
  done

  if command -v glab >/dev/null 2>&1; then
    log "ok: glab available"
  else
    log "info: glab not found (needed only for GitLab overlay)"
  fi
  if command -v gh >/dev/null 2>&1; then
    log "ok: gh available"
  else
    log "info: gh not found (needed only for GitHub workflows)"
  fi

  if [[ "$errors" -gt 0 ]]; then
    die "doctor found $errors issue(s)"
  fi
  log "doctor: healthy"
}

usage() {
  cat <<'EOF'
Usage: scripts/agent <command> [blueprint] [flags]

Commands:
  init                 Write AGENTS.md, CLAUDE.md, memory, .gitignore (no tool runtime)
  install <blueprint>  Install blueprint into --target runtimes
  update               Show update plan vs package VERSION
  sync                 Re-apply installed blueprint with preserve-local
  doctor               Validate package + target install health

Blueprints:
  default | engineering | startup

Flags:
  --overlay gitlab     Install GitLab/glab command overlay
  --runtime NAME       cursor | claude | all
                       (omit to get an interactive selector; both tools optional)
  --target PATH        Consumer project root (default .)
  --dry-run            Print actions without writing
  --force              Overwrite unmanaged files
EOF
}

case "$cmd" in
  init) cmd_init ;;
  install) cmd_install ;;
  update) cmd_update ;;
  sync) cmd_sync ;;
  doctor) cmd_doctor ;;
  -h|--help|help|"") usage; [[ -n "$cmd" ]] || exit 2 ;;
  *) die "unknown command: $cmd (see --help)" ;;
esac
